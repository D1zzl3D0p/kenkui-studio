{
  "name": "kenkui-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "vite --mode native",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../kenkui-server/openapi/v1.json -o src/api/generated/schema.ts --default-non-nullable false",
    "test:e2e": "playwright test",
    "check:api": "openapi-typescript ../kenkui-server/openapi/v1.json -o src/api/generated/schema.ts --default-non-nullable false --check",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^22.20.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "openapi-typescript": "7.13.0",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.131.1"
  }
}
