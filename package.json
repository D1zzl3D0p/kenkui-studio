{
  "name": "kenkui-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../kenkui-server/openapi/v1.json -o src/api/generated/schema.ts --default-non-nullable false",
    "test:e2e": "playwright test",
    "check:api": "openapi-typescript ../kenkui-server/openapi/v1.json -o src/api/generated/schema.ts --default-non-nullable false --check",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "openapi-typescript": "7.13.0",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.131.1"
  }
}
