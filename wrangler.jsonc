{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kenkui-web",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "staging": {
      "name": "kenkui-web-staging",
      "routes": [{"pattern": "app.staging.kenkui.fm", "custom_domain": true}]
    },
    "production": {
      "name": "kenkui-web-production",
      "routes": [{"pattern": "app.kenkui.fm", "custom_domain": true}]
    }
  }
}
